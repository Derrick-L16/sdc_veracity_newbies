# Variable names only. Never commit real values; on Replit use Secrets.

# API server (artifacts/api-server)
# PORT=8080
# Exact browser origin trusted for POST requests, no trailing slash.
# APP_ORIGIN=http://localhost:5173
# Replit App Storage directory for case evidence uploads (uploads fail without it).
# PRIVATE_OBJECT_DIR=
# LOG_LEVEL=info

# Python backend (artifacts/api-server/backend)
# VERACITY_DB=/absolute/path/to/veracity.sqlite3
# VERACITY_DEMO_MODE=true

# Local run without Replit (local-dev/frontend.mjs)
# BACKEND_URL=http://127.0.0.1:8000
# WEB_PORT=5173
